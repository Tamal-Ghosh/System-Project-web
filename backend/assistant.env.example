# Backend only. Copy the publisher-provided runtime connection privately into backend/.env.
# Never put this credential in frontend variables, Git, Dockerfiles or an image.
ASSISTANT_STORAGE=postgres
ASSISTANT_DATABASE_URL=postgresql://RUNTIME_USER:RUNTIME_PASSWORD@SUPABASE_HOST:5432/postgres?sslmode=require
# Existing GEMINI_API_KEY and GEMINI_CHAT_MODEL settings remain in the private backend env.
